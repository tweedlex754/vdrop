{
  "name": "vdrop",
  "version": "0.1.0",
  "private": true,
  "description": "Native, Rust-powered media downloader (Tauri 2)",
  "license": "MIT",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "cargo test --workspace",
    "test:live": "cargo test -p vdrop-download --test live_download -- --ignored && cargo test -p vdrop-media --test live_stream -- --ignored",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "test:front": "npm run test --workspace frontend"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}